{
  "name": "featurama",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/serve.ts",
    "check": "tsc --noEmit && bun test",
    "test:gpu": "node scripts/gpu-test.mjs",
    "build": "rm -rf dist && bun build ./index.html --outdir dist --minify --public-path=${PUBLIC_PATH:-./} && cp -R public/. dist/ && cp dist/index.html dist/404.html",
    "model": "tools/reference/.venv/bin/python -I tools/reference/convert.py",
    "fixtures": "tools/reference/.venv/bin/python -I tools/reference/fixtures.py"
  },
  "license": "MIT",
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@webgpu/types": "^0.1.74",
    "bun-types": "^1.4.3",
    "playwright-core": "^1.64.0",
    "typescript": "^5.9.3"
  }
}
